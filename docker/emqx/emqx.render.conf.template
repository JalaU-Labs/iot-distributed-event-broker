node {
  name = "emqx@127.0.0.1"
  cookie = "emqxsecretcookie"
  data_dir = "/opt/emqx/data"
  db_backend = "rlog"
  dist_net_ticktime = 120
}

cluster {
  proto_dist = "inet_tcp"
}

log {
  console {
    enable = true
    level = warning
  }
  file {
    enable = false
  }
}

listeners.tcp.default {
  enable = false
}

listeners.ssl.default {
  enable = false
}

listeners.wss.default {
  enable = false
}

listeners.ws.default {
  bind = "127.0.0.1:__MQTT_WS_PORT__"
  websocket.mqtt_path = "/mqtt"
}

dashboard {
  listeners.http {
    enable = false
  }
}

authorization {
  no_match = allow
  deny_action = ignore
}