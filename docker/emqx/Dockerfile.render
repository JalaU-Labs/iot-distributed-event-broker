FROM emqx/emqx:5.8.0

ENV TZ=America/Bogota \
    EMQX_LISTENERS__TCP__DEFAULT__ENABLE=false \
    EMQX_LISTENERS__SSL__DEFAULT__ENABLE=false \
    EMQX_LISTENERS__WS__DEFAULT__ENABLE=true \
    EMQX_LISTENERS__WS__DEFAULT__WEBSOCKET__MQTT_PATH=/mqtt

# Docker does not expand ${PORT} inside ENV instructions, and EMQX does not
# expand it either when the value comes from its own environment. A small
# wrapper script resolves the port at runtime, right before EMQX starts.
RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -e' \
    'export EMQX_LISTENERS__WS__DEFAULT__BIND="0.0.0.0:${PORT:-8083}"' \
    'exec /usr/bin/docker-entrypoint.sh "$@"' \
    > /usr/local/bin/render-entrypoint.sh \
    && chmod +x /usr/local/bin/render-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/render-entrypoint.sh"]