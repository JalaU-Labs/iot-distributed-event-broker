FROM emqx/emqx:5.8.0

ENV TZ=America/Bogota \
    EMQX_LISTENERS__TCP__DEFAULT__ENABLE=false \
    EMQX_LISTENERS__SSL__DEFAULT__ENABLE=false \
    EMQX_LISTENERS__WS__DEFAULT__ENABLE=true \
    EMQX_LISTENERS__WS__DEFAULT__WEBSOCKET__MQTT_PATH=/mqtt

# Create the entrypoint as root (the emqx user cannot write to /usr/bin),
# then return to the unprivileged emqx user.
USER root
COPY docker/emqx/render-entrypoint.sh /usr/bin/render-entrypoint.sh
RUN chmod +x /usr/bin/render-entrypoint.sh
USER emqx

ENTRYPOINT ["/usr/bin/render-entrypoint.sh"]
CMD ["/opt/emqx/bin/emqx", "foreground"]