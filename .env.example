# =============================================================================
# Environment variables
# =============================================================================
#
# This file is read by two consumers:
#
#   1. Docker Compose, for substitutions in `docker-compose.yml` (via
#      `${VAR}` or `${VAR:-default}` syntax).
#   2. pydantic-settings, when any command runs from the host, such as
#      `uv run iot-consumer` or `uv run iot-publisher`.
#
# The Docker Compose services hardcode the internal broker address
# (`emqx:1883`) in their own environment block, so the values under
# "MQTT Broker" below affect only host-run CLI processes.
# =============================================================================

# -----------------------------------------------------------------------------
# Container runtime (Docker Compose only)
# -----------------------------------------------------------------------------

# Timezone shared by every container.
TZ=America/Bogota

# EMQX dashboard credentials.
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=public

# Host port mapping. Change these if the defaults clash with other services.
MQTT_TCP_PORT=1883
MQTT_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083

# -----------------------------------------------------------------------------
# MQTT broker (read by the CLI from the host)
# -----------------------------------------------------------------------------
#
# Local broker (default when running `make up-broker`).
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TRANSPORT=tcp
MQTT_USE_TLS=false
MQTT_WS_PATH=
#
# Cloud broker (Render, WebSocket over TLS). Uncomment to switch.
# MQTT_BROKER_HOST=iot-emqx-broker.onrender.com
# MQTT_BROKER_PORT=443
# MQTT_TRANSPORT=websockets
# MQTT_USE_TLS=true
# MQTT_WS_PATH=/mqtt

MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS_LEVEL=1
MQTT_TOPIC_PREFIX=iot/sensors
MQTT_KEEPALIVE_SECONDS=60
MQTT_RECONNECT_INTERVAL_SECONDS=5

# -----------------------------------------------------------------------------
# Weather API (read by the publisher)
# -----------------------------------------------------------------------------
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=4.6097
WEATHER_LONGITUDE=-74.0817
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_REQUEST_TIMEOUT_SECONDS=10
WEATHER_MAX_RETRIES=3
WEATHER_INITIAL_RETRY_WAIT_SECONDS=1

# -----------------------------------------------------------------------------
# Device (read by the publisher; the containerised publisher inherits
# these values through docker-compose.yml)
# -----------------------------------------------------------------------------
DEVICE_DEVICE_ID=sensor-001
DEVICE_PUBLISH_INTERVAL_SECONDS=2
DEVICE_MIN_TEMPERATURE_CELSIUS=15
DEVICE_MAX_TEMPERATURE_CELSIUS=30
DEVICE_TEMPERATURE_VARIATION_CELSIUS=0.5

# -----------------------------------------------------------------------------
# Broker wake-up (cloud only)
# -----------------------------------------------------------------------------
# When the broker runs on Render's free tier it sleeps after 15 minutes
# of inactivity. Enable the wake-up waiter to poll the demo publisher's
# /health endpoint until the broker is reachable.
WAKEUP_ENABLED=false
WAKEUP_URL=https://iot-demo-publisher.onrender.com/health
WAKEUP_TIMEOUT_SECONDS=180
WAKEUP_INTERVAL_SECONDS=5
WAKEUP_REQUEST_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false