# MQTT Broker Configuration (Local - TCP)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TRANSPORT=tcp
MQTT_USE_TLS=false
MQTT_WS_PATH=

# MQTT Broker Configuration (Render - WebSocket)
# Uncomment and adjust for Render deployment:
# MQTT_BROKER_HOST=iot-emqx-broker.onrender.com
# MQTT_BROKER_PORT=443
# MQTT_TRANSPORT=websockets
# MQTT_USE_TLS=true
# MQTT_WS_PATH=/mqtt

MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS_LEVEL=1
MQTT_TOPIC_PREFIX=iot/sensors

# Weather API Configuration
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=4.6097
WEATHER_LONGITUDE=-74.0817
WEATHER_CACHE_TTL_SECONDS=300

# Device Configuration
DEVICE_ID=sensor-001
PUBLISH_INTERVAL_SECONDS=2